{
  "name": "style-studio-engine",
  "version": "0.1.0",
  "private": true,
  "description": "One Remotion engine, many editing styles: a style pack (fonts, palette, grounds, captions, layout rules, motion, the scene types it brings) drives every scene.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcostuliodias/style-studio.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "remotion studio src/board/entry.tsx --port 3480",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/render-stills.mjs",
    "reel": "node scripts/render-reel.mjs",
    "check": "node scripts/check-plan.mjs",
    "skill": "node scripts/make-skill.mjs",
    "studio:web": "vite --config studio/vite.config.ts",
    "studio:build": "vite build --config studio/vite.config.ts",
    "studio:serve": "node studio/serve.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/cli": "4.0.530",
    "@remotion/fonts": "4.0.530",
    "@remotion/player": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "jszip": "3.10.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "5.8.2",
    "vite": "^6.3.5"
  }
}
